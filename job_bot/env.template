# Sparse credential template for private_data/credentials/passport.env.
# Never commit private candidate data, browser storage-state JSON, passwords, or tokens.
JOBBOT_EMAIL_TO=""
# Fill only values you actually use; a missing variable is treated as empty.
# A short curated set of blank fields is kept below for convenient editing.
#
# Naming rules (replace <SLUG> with uppercase letters/numbers/underscores):
#   COMPANY_<SLUG>_USERNAME=""
#   COMPANY_<SLUG>_PASSWORD=""
#   COMPANY_<SLUG>_COOKIE=""
#   COMPANY_<SLUG>_STORAGE_STATE=""
#   PLATFORM_<SLUG>_USERNAME=""
#   PLATFORM_<SLUG>_PASSWORD=""
#   PLATFORM_<SLUG>_COOKIE=""
#   PLATFORM_<SLUG>_STORAGE_STATE=""
#
# Examples:
#   COMPANY_NVIDIA_COOKIE="name=value; other=value"
#   COMPANY_AMD_USERNAME="name@example.com"
#   PLATFORM_CUHK_CAREERS_COOKIE="SSESS...=..."
#   PLATFORM_LINKEDIN_STORAGE_STATE="private_data/browser/state/linkedin.json"
#   SMTP_USERNAME="name@example.com"
#   SMTP_PASSWORD="app-password-or-token"
#
# *_COOKIE is the Cookie REQUEST header for exactly one target domain. Do not
# paste Set-Cookie attributes or reuse Google/LinkedIn cookies on other hosts.
# Prefer *_STORAGE_STATE for OAuth, SSO, localStorage, CAPTCHA, or 2FA flows.
# Username/password fields are reserved for interactive login adapters; current
# collectors do not automatically submit them.

# Windows dedicated Chrome exposed to WSL through the restricted portproxy.
