{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Structured private resume content",
  "type": "object",
  "required": [
    "version",
    "summary_fact_ids",
    "skill_fact_ids",
    "projects"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "summary_fact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "skill_fact_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "dates",
          "keywords",
          "fact_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "dates": {
            "type": "string",
            "minLength": 1
          },
          "section": {
            "enum": [
              "Projects",
              "Research Experience"
            ]
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fact_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
